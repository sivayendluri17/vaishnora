{
  "name": "@vaishnora/shared-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared metric and alarm types used by @vaishnora/metrics and @vaishnora/alarmist.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
