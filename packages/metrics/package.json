{
  "name": "@vaishnora/metrics",
  "version": "0.1.0",
  "private": true,
  "description": "Application metrics: record counters/gauges/timers and publish them to CloudWatch. Ships a Lambda ingest endpoint.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "bundle": "esbuild src/handler.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/lambda/handler.mjs --external:@aws-sdk/*",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1103.0",
    "@vaishnora/shared-contracts": "*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  }
}
