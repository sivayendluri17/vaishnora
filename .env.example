# Each app reads its own .env.local (apps/storefront/.env.local, apps/admin/.env.local).
# Copy the relevant block there. Never commit .env.local files.

# ---------------------------------------------------------------- both apps
AUTH_SECRET=change-me-to-a-long-random-string          # must be IDENTICAL in both apps (shared session cookie)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Set in production only, so admin.<domain> and <domain> share the login cookie. Leave unset on localhost.
# COOKIE_DOMAIN=.vaishnora.shop
# Shared secret the admin app uses to ask the storefront to refresh its cache. Same value in both apps.
REVALIDATE_SECRET=change-me-too
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_IMAGE_CDN=https://images.vaishnora.shop

# AWS. Access keys are for local dev only; in Amplify leave them unset so the compute role is used.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- storefront only
SES_FROM_EMAIL=no-reply@yourdomain.com                 # forgot-password email

# ---------------------------------------------------------------- admin only
S3_BUCKET_NAME=                                        # product photo uploads
STOREFRONT_URL=http://localhost:3000                   # server-side target for revalidation calls
AMPLIFY_APP_ID=                                        # /admin/metrics (see infra/observability/README.md)
RUM_APP_MONITOR_NAME=
# CW_ALARM_PREFIX=vaishnora-
