# Copy to .env.local. Never commit .env.local to git.
AUTH_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AWS SES / SNS (forgot-password email + SMS codes)
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are for local dev only — leave
# them unset in Amplify prod so the SDK falls back to the compute service role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@yourdomain.com
